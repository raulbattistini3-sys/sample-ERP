# Copy to .env and fill in real values. Never commit .env.

# HTTP server. On Render set PORT=10000 explicitly and leave APP_HOST unset (it binds 0.0.0.0 there);
# APP_PORT is still read locally when PORT is not set
# 127.0.0.1, not localhost: Node can bind localhost to IPv6 only, and Java (billing) resolves it to IPv4
APP_HOST=127.0.0.1
PORT=3333

# How the API connects to Postgres (src/configs/database_connection.ts); required, nothing starts without it.
#   production   TLS, verifying the server's certificate with DATABASE_CA_CERT; sslmode=disable is refused
#   development  plain connection, unless DATABASE_CA_CERT is set
API_ENV=development
# CA that signs the database's certificate. In production it defaults to prod-ca-2021.crt (Supabase's root
# CA, in the repo root), found from the working directory upwards. Relative paths are from that directory.
DATABASE_CA_CERT=

# Postgres connection string, read by Config.getDb(), pg-boss, drizzle-kit and the scripts
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sample_erp

# Browser origins allowed to call the API (comma-separated); defaults to the Vite dev server
CORS_ORIGINS=http://localhost:5173

# Secret used to sign login JWTs; generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# "Esqueceu a senha?" emails, sent through Resend (https://resend.com/api-keys)
RESEND_API_KEY=change-me-and-enter-your-own-resend-api-key
# Sender; must be on a domain verified in Resend. Leave empty to use Resend's test sender
# (onboarding@resend.dev), which only delivers to the Resend account owner's email
EMAIL_FROM=
# Web app address, used to build the reset link (<WEB_URL>/reset-password?token=...)
WEB_URL=http://localhost:5173

# --- Integrations (src/configs/oauth.providers.ts) ---
# Key that encrypts the integration tokens stored in the database (32 random bytes, base64):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it makes stored connections unreadable: connect them again.
INTEGRATIONS_ENCRYPTION_KEY=
# This API's public address; the OAuth callback is <API_PUBLIC_URL>/integracoes/<provider>/callback
# (defaults to http://localhost:<PORT>)
API_PUBLIC_URL=http://localhost:3333
# Jira: create an OAuth 2.0 (3LO) app at https://developer.atlassian.com/console/myapps/
#   Permissions > Jira API: read:jira-work, write:jira-work
#   Authorization > Callback URL: <API_PUBLIC_URL>/integracoes/jira/callback
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
# HubSpot, simplest for one account: a service key (Development > Keys > Service keys) with the scopes
# below. Set it and the API calls HubSpot with it, without connecting in Integrações. Ticket sending
# still needs the OAuth connection, which keeps its pipeline and status.
# HubSpot with OAuth: create an app with the HubSpot CLI (hs project create); in its app-hsmeta.json:
#   auth.redirectUrls: <API_PUBLIC_URL>/integracoes/hubspot/callback (https, or http://localhost)
#   auth.requiredScopes: crm.objects.tickets.read, crm.objects.tickets.write, crm.objects.contacts.read,
#   crm.objects.companies.read
# Client ID and secret: hs project open > your app > Auth

# --- Job queue (pg-boss, in this same Postgres) ---
# Schema for the queue tables; pg-boss creates and migrates it on startup. Jobs: "jira-issues"
# (one per Jira issue of a new auditoria) and its dead-letter queue "jira-issues-dlq".
PGBOSS_SCHEMA=pgboss

# --- Spreadsheet imports ---
# host:port of the Go importer's gRPC server (importer:50051 in docker compose, localhost:50051 when run
# with go run). Empty: the API runs the imports itself, in the same importacoes table.
# Processes running those imports at the same time; each uses one thread per CPU. Leave it at 1 unless
# several big imports must run at once.
IMPORT_PROCESSES=1
IMPORTER_GRPC_URL=

BILLING_INTERNAL_TOKEN=
# Where the billing service listens: Stripe status on Integrações and the Cobranças page go through it
# (e.g. http://127.0.0.1:8081). Empty: those pages say billing isn't configured.
BILLING_URL=
# Sender of the cobrança e-mails; any address Resend accepts. Empty: EMAIL_FROM, else Resend's test sender
# (which only delivers to the Resend account owner).
COBRANCAS_EMAIL_FROM=

# --- Telemetry (pkg/telemetry) ---
# Folder for the web's search timings (POST /telemetry) and the API's product snapshot builds, one
# NDJSON file per day. Empty: events are accepted and dropped. The launcher sets data/telemetry.
TELEMETRY_DIR=

# --- First superuser ---
# With both set, startup creates this SU when the database has no active one (src/services/bootstrap_su.ts).
# The password is a known one, so the account must change it at first sign-in. Leave empty in production.
BOOTSTRAP_SU_NAME=
BOOTSTRAP_SU_EMAIL=
BOOTSTRAP_SU_PASSWORD=

HUBSPOT_ACCESS_KEY=
HUBSPOT_DEVELOPER_KEY=
HUBSPOT_SERVICE_KEY=