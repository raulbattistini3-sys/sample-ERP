# Copy to .env and fill in real values. Never commit .env.

# HTTP server. On Render set PORT=10000 explicitly and leave APP_HOST unset (it binds 0.0.0.0 there);
# APP_PORT is still read locally when PORT is not set
APP_HOST=localhost
PORT=3333

# Postgres connection string, read by Config.getDb() and drizzle-kit (drizzle.config.ts)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sample_erp

# Browser origins allowed to call the API (comma-separated); defaults to the Vite dev server
CORS_ORIGINS=http://localhost:5173

# Secret used to sign login JWTs; generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# "Esqueceu a senha?" emails, sent through Resend (https://resend.com/api-keys)
RESEND_API_KEY=change-me-and-enter-your-own-resend-api-key
# Sender; must be on a domain verified in Resend. Leave empty to use Resend's test sender
# (onboarding@resend.dev), which only delivers to the Resend account owner's email
EMAIL_FROM=
# Web app address, used to build the reset link (<WEB_URL>/reset-password?token=...)
WEB_URL=http://localhost:5173

# --- Integrations (src/configs/oauth.providers.ts) ---
# Key that encrypts the integration tokens stored in the database (32 random bytes, base64):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it makes stored connections unreadable: connect them again.
INTEGRATIONS_ENCRYPTION_KEY=
# This API's public address; the OAuth callback is <API_PUBLIC_URL>/integracoes/<provider>/callback
# (defaults to http://localhost:<PORT>)
API_PUBLIC_URL=http://localhost:3333
# Jira: create an OAuth 2.0 (3LO) app at https://developer.atlassian.com/console/myapps/
#   Permissions > Jira API: read:jira-work, write:jira-work
#   Authorization > Callback URL: <API_PUBLIC_URL>/integracoes/jira/callback
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
# HubSpot: create an app with the HubSpot CLI (hs project create); in its app-hsmeta.json:
#   auth.redirectUrls: <API_PUBLIC_URL>/integracoes/hubspot/callback (https, or http://localhost)
#   auth.requiredScopes: crm.objects.tickets.read, crm.objects.tickets.write, crm.objects.contacts.read
# Client ID and secret: hs project open > your app > Auth
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=

# --- Job queue (pg-boss, in this same Postgres) ---
# Schema for the queue tables; pg-boss creates and migrates it on startup. Jobs: "jira-issues"
# (one per Jira issue of a new auditoria) and its dead-letter queue "jira-issues-dlq".
PGBOSS_SCHEMA=pgboss

# --- Spreadsheet imports ---
# host:port of the Go importer's gRPC server (importer:50051 in docker compose, localhost:50051 when run
# with go run). Empty: the API runs the imports itself, in the same importacoes table.
# Processes running those imports at the same time; each uses one thread per CPU. Leave it at 1 unless
# several big imports must run at once.
IMPORT_PROCESSES=1
IMPORTER_GRPC_URL=
