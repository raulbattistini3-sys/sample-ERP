# Copy to .env and fill in real values. Never commit .env.

# HTTP server
APP_HOST=localhost
APP_PORT=3333

# Postgres connection string, read by Config.getDb() and drizzle-kit (drizzle.config.ts)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sample_erp

# Browser origins allowed to call the API (comma-separated); defaults to the Vite dev server
CORS_ORIGINS=http://localhost:5173

# Secret used to sign login JWTs; generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
