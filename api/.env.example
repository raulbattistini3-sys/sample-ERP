# Copy to .env and fill in real values. Never commit .env.

# HTTP server
APP_HOST=localhost
APP_PORT=3333

# Postgres connection string, read by drizzle-kit (drizzle.config.ts)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sample_erp

# Separate connection fields, read by Config.getDb() while it builds the pool from them
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sample_erp
DB_USERNAME=postgres

# Secret used to sign login JWTs; generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
