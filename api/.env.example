# Copy to .env and fill in real values. Never commit .env.

# HTTP server. On Render set PORT=10000 explicitly and leave APP_HOST unset (it binds 0.0.0.0 there);
# APP_PORT is still read locally when PORT is not set
# 127.0.0.1, not localhost: Node can bind localhost to IPv6 only, and Java (billing) resolves it to IPv4
APP_HOST=127.0.0.1
PORT=3333

# HTTPS, TLS 1.3 only, for the browser (web <-> api) and for billing. The certificate names api, localhost
# and 127.0.0.1 and is also the API's client certificate towards the importer, the vault and billing;
# API_TLS_CA (the internal CA) checks billing's certificate, both when billing calls /internal/billing
# (mutual TLS, CN=billing) and when the API calls billing. All three or none: empty = plain HTTP and no
# billing link (refused when API_ENV=production). Written by `cd secrets && bun generate.ts`; browsers trust
# it once secrets/tls/ca.crt is imported (README, "Trusting the local CA").
API_TLS_CERT=../secrets/tls/api.crt
API_TLS_KEY=../secrets/tls/api.key
API_TLS_CA=../secrets/tls/ca.crt

# Needed for the development instance too, not only production: with `go run ./network/cmd/network dev` the
# gateway reaches the API over https and billing calls back with its certificate, so leave these set.
# Relative paths are from api/.

# Development only: the API starts these services as its own child processes (logs prefixed [importer],
# [vault], [billing]; stopped with the API). `go run ./network/cmd/network dev` sets it to all three (its
# DEV_API_CHILDREN overrides). Each child gets the secrets/tls/ certificates for its side of the mutual
# TLS by default; a GRPC_TLS_*, VAULT_TLS_* or BILLING_TLS_* line in its own .env wins.
# Comma-separated subset of importer,vault,billing; empty = none. API_CHILDREN_ROOT: the repo root (default ..).
API_CHILDREN=
API_CHILDREN_ROOT=

# How the API connects to Postgres (src/configs/database_connection.ts); required, nothing starts without it.
#   production   TLS, verifying the server's certificate with DATABASE_CA_CERT; sslmode=disable is refused
#   development  plain connection, unless a CA is found (DATABASE_CA_CERT, or a .crt file in the repo root): then verified TLS
API_ENV=development
# CA that signs the database's certificate. In production it defaults to prod-ca-2021.crt (Supabase's root
# CA, in the repo root), found from the working directory upwards. Relative paths are from that directory.
DATABASE_CA_CERT=

# Postgres connection string, read by Config.getDb(), pg-boss, drizzle-kit and the scripts
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sample_erp

# Browser origins allowed to call the API (comma-separated); defaults to the Vite dev server
CORS_ORIGINS=https://localhost:5173

# HS256 key that signs the login JWTs (jose; iss sample-erp-api, aud sample-erp-web). Generate it, with the
# other shared secrets below, from the repository root:
#   cd secrets && bun install && bun generate.ts
# then copy JWT_SECRET from secrets/secrets.env (docker compose loads that file by itself).
JWT_SECRET=

# "Esqueceu a senha?" emails, sent through Resend (https://resend.com/api-keys)
RESEND_API_KEY=change-me-and-enter-your-own-resend-api-key
# Sender; must be on a domain verified in Resend. Leave empty to use Resend's test sender
# (onboarding@resend.dev), which only delivers to the Resend account owner's email
EMAIL_FROM=
# Web app address, used to build the reset link (<WEB_URL>/reset-password?token=...)
WEB_URL=https://localhost:5173

# --- Integrations (src/configs/oauth.providers.ts) ---
# Key that encrypts the integration tokens stored in the database (32 random bytes, base64):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it makes stored connections unreadable: connect them again.
INTEGRATIONS_ENCRYPTION_KEY=
# This API's public address; the OAuth callback is <API_PUBLIC_URL>/integracoes/<provider>/callback
# (defaults to http://localhost:<PORT>)
API_PUBLIC_URL=https://localhost:3333
# Jira: create an OAuth 2.0 (3LO) app at https://developer.atlassian.com/console/myapps/
#   Permissions > Jira API: read:jira-work, write:jira-work
#   Authorization > Callback URL: <API_PUBLIC_URL>/integracoes/jira/callback
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
# HubSpot, simplest for one account: a service key (Development > Keys > Service keys) with the scopes
# below. Set it and the API calls HubSpot with it, without connecting in Integrações. Ticket sending
# still needs the OAuth connection, which keeps its pipeline and status.
# HubSpot with OAuth: create an app with the HubSpot CLI (hs project create); in its app-hsmeta.json:
#   auth.redirectUrls: <API_PUBLIC_URL>/integracoes/hubspot/callback (https, or http://localhost)
#   auth.requiredScopes: crm.objects.tickets.read, crm.objects.tickets.write, crm.objects.contacts.read,
#   crm.objects.contacts.write (Clientes creates and edits contacts),
#   crm.objects.companies.read, crm.objects.companies.write (Criar empresa, linking a client to it),
#   crm.schemas.companies.read (the Setor list: HubSpot only takes its own industry values),
#   crm.objects.owners.read (the Responsável of a company)
# Notes, e-mails and meetings on the timeline go through the contacts/companies write scopes.
# Client ID and secret: hs project open > your app > Auth

# --- Job queue (pg-boss, in this same Postgres) ---
# Schema for the queue tables; pg-boss creates and migrates it on startup. Jobs: "jira-issues"
# (one per Jira issue of a new auditoria) and its dead-letter queue "jira-issues-dlq".
PGBOSS_SCHEMA=pgboss

# --- Spreadsheet imports ---
# host:port of the Go importer's gRPC server (importer:50051 in docker compose, localhost:50051 when run
# with go run). Empty: the API runs the imports itself, in the same importacoes table.
# The link is mutual TLS: the CA that signed the importer's certificate, and the API's own client
# certificate and key (secrets/tls/ from secrets/generate.ts). Set all three or none; required when
# API_ENV=production. Without them the API connects in plaintext, which only an importer without
# GRPC_TLS_* accepts. Relative paths are from api/.
# Processes running those imports at the same time; each uses one thread per CPU. Leave it at 1 unless
# several big imports must run at once.
IMPORT_PROCESSES=1
IMPORTER_GRPC_URL=
IMPORTER_TLS_CA=../secrets/tls/ca.crt
IMPORTER_TLS_CERT=../secrets/tls/api.crt
IMPORTER_TLS_KEY=../secrets/tls/api.key
# the name the importer's certificate must hold (default importer), whatever host IMPORTER_GRPC_URL uses
IMPORTER_TLS_SERVER_NAME=importer

# --- Vault (vault/, Go): usuarios' CPF and birth dates, encrypted in its own database ---
# Empty VAULT_URL: the API runs without it, and creating a usuario with cpf / dataNascimento answers 503.
# VAULT_TOKEN comes from secrets/secrets.env (the vault holds only its SHA-256). Mutual TLS with secrets/tls.
VAULT_URL=
VAULT_TOKEN=
VAULT_TLS_CA=../secrets/tls/ca.crt
VAULT_TLS_CERT=../secrets/tls/api.crt
VAULT_TLS_KEY=../secrets/tls/api.key
VAULT_TLS_SERVER_NAME=vault

# --- Billing service (billing/, Java) ---
# Mutual TLS both ways, no shared token: the API calls billing with API_TLS_CERT and billing's certificate
# must name BILLING_TLS_SERVER_NAME (default billing); billing calls /internal/billing with its own (CN=billing).
BILLING_TLS_SERVER_NAME=billing

# --- Network service (network/, Go) ---
# The registry's control address and its shared token (32+ characters, the same in every service; copy
# NETWORK_TOKEN from secrets/secrets.env). With them
# the API announces itself as "api" at the port it bound and finds billing and the importer by name, so
# BILLING_URL and IMPORTER_GRPC_URL become fallbacks. Empty: the fixed URLs above and below are used.
NETWORK_URL=
NETWORK_TOKEN=
# the host the others reach this API on (default 127.0.0.1)
NETWORK_ADVERTISE_HOST=
# reCAPTCHA v3, checked by the network gateway (not by the API): on the login and for clients that flood it
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET=
# Where the billing service listens: Stripe status on Integrações and the Cobranças page go through it
# (https only, e.g. https://127.0.0.1:8081; an http:// URL is refused). With NETWORK_URL/NETWORK_TOKEN it
# is only the fallback. Empty: those pages say billing isn't configured.
BILLING_URL=
# Sender of the cobrança e-mails; any address Resend accepts. Empty: EMAIL_FROM, else Resend's test sender
# (which only delivers to the Resend account owner).
COBRANCAS_EMAIL_FROM=
# Pagamentos mensais: the worker that issues each cycle (true turns it off, e.g. on a second API instance)
PAGAMENTOS_RECORRENTES_DESLIGADOS=

# --- WhatsApp (Meta WhatsApp Cloud API) ---
# The cobrança e-mail also goes by WhatsApp to the client's mobile (mobilephone, else phone, in HubSpot).
# Empty token or phone number id: WhatsApp is off and the e-mail is the only message.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Approved message template (Meta only delivers free text inside 24h of the client's last message). Its body
# takes 7 parameters: {{1}} name, {{2}} issuer, {{3}} invoice number, {{4}} description, {{5}} amount,
# {{6}} due date, {{7}} payment link. Empty: free text.
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_IDIOMA=pt_BR
WHATSAPP_API_VERSION=v23.0

# --- Auditorias ---
# Product and categoria changes wait in alteracoes_pendentes and become auditorias every N minutes: one per
# single edit, one batch per bulk action (inativar em lote, preços, quantidades, imports).
AUDITORIAS_INTERVALO_MINUTOS=5

# --- Telemetry (pkg/telemetry) ---
# Folder for the web's search timings (POST /telemetry) and the API's product snapshot builds, one
# NDJSON file per day. Empty: events are accepted and dropped. The launcher sets data/telemetry.
TELEMETRY_DIR=

# --- First superuser ---
# With both set, startup creates this SU when the database has no active one (src/services/bootstrap_su.ts).
# The password is a known one, so the account must change it at first sign-in. Leave empty in production.
BOOTSTRAP_SU_NAME=
BOOTSTRAP_SU_EMAIL=
BOOTSTRAP_SU_PASSWORD=

HUBSPOT_ACCESS_KEY=
HUBSPOT_DEVELOPER_KEY=
HUBSPOT_SERVICE_KEY=

# development, dev.* or production. Dev-only tools (Gerar dados fictícios, search timing lines) need a value
# starting with dev. Unset: development under `vite`, production in `vite build`.
VITE_ENVIRONMENT=

#The API's own certificate (secrets/tls/api.crt, or data/certs/api.crt from the launcher):
#  API_TLS_CERT  PEM certificate, names api, localhost, 127.0.0.1. Serves HTTPS (TLS 1.3 only) to the
#                browser and to billing, and is the client certificate the API shows billing
#  API_TLS_KEY   its private key
#  API_TLS_CA    the internal CA: checks the certificates billing presents (CN billing), and billing's
#                server certificate when the API calls it
#All three empty: plain HTTP and no billing link, which API_ENV=production refuses.
#
