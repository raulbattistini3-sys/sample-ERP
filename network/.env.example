# Network service: the service registry plus the public gateway in front of the browser.
# Copy to network/.env and fill in the values. Never commit .env.
#
# Where the file is read from:
#   - `go run ./network/cmd/network` from the repo root reads network/.env
#   - started from inside network/, it reads .env
# Variables already in the environment win over this file, so Docker Compose and the launcher keep
# control. Relative paths below are resolved from the folder the command runs in; the examples assume the
# repo root.
# Lines are KEY=value. An empty value means the default.

# --- Environment -------------------------------------------------------------------------------------

# development | production (default production). Development turns on readable logs and, when a port is
# taken, the next free one.
NETWORK_ENV=development

# json | text (default json, or text in development); debug | info | warn | error (default info)
LOG_FORMAT=
LOG_LEVEL=

# --- Addresses ---------------------------------------------------------------------------------------

# Public gateway: the only address the browser talks to (default :8080).
NETWORK_ADDR=:8080

# Registry (control plane), where api, billing, importer and web announce themselves. Keep it on a private
# interface (default 127.0.0.1:7070). Every service reaches it through NETWORK_URL, e.g.
# NETWORK_URL=http://127.0.0.1:7070 in their own .env.
NETWORK_CONTROL_ADDR=127.0.0.1:7070

# --- Registry security -------------------------------------------------------------------------------

# Required. The shared secret that signs registry calls; the same value in every service. Format: 64
# lowercase hex characters (SHA-256 of 32 random bytes); anything under 32 characters is refused.
# Make one with `cd secrets && bun run network-token`, or take it from secrets/secrets.env.
NETWORK_TOKEN=

# Allow instances to register non-private (public) addresses: true | false (default false). Leave it off
# unless the services really run on separate public hosts.
NETWORK_ALLOW_PUBLIC_REGISTRATION=false

# --- Routing -----------------------------------------------------------------------------------------

# Path prefix -> service name, comma separated. Every prefix except "/" is stripped before forwarding,
# so /api/user/login reaches the api as /user/login. Default: /api=api,/billing=billing,/=web
NETWORK_ROUTES=/api=api,/billing=billing,/=web

# Folder with the built web app (web/dist), served for "/" when no "web" instance is registered, e.g. in
# production without a web server. Empty: "/" goes only to a registered web instance.
NETWORK_WEB_DIR=

# --- TLS ---------------------------------------------------------------------------------------------

# Serve the gateway over HTTPS (TLS 1.3 only). Set both or neither; empty: plain HTTP.
# The secrets/ certificates work for local use, e.g. the web one:
#   NETWORK_TLS_CERT=secrets/tls/web.crt
#   NETWORK_TLS_KEY=secrets/tls/web.key
NETWORK_TLS_CERT=
NETWORK_TLS_KEY=

# CA that the api and billing certificates chain to; the gateway checks them when it forwards over HTTPS.
# Empty: the system's trusted CAs.
NETWORK_UPSTREAM_CA=secrets/tls/ca.crt

# --- Abuse protection --------------------------------------------------------------------------------

# Per-client token bucket: requests per second and the burst on top (defaults 20 and 40).
NETWORK_RATE=20
NETWORK_BURST=40

# Trust X-Forwarded-For for the client address: true | false (default false). Only behind a reverse proxy
# you run; otherwise anyone can fake their address and dodge the rate limit.
NETWORK_TRUST_PROXY=false

# Identical requests from the same client within this many milliseconds run once (double clicks).
# Default 2000.
NETWORK_DEDUPE_MS=2000

# Body size caps in MB: every request, and the spreadsheet import routes (defaults 1 and 128).
NETWORK_MAX_BODY_MB=1
NETWORK_MAX_IMPORT_MB=128

# --- reCAPTCHA v3 (optional) -------------------------------------------------------------------------

# With RECAPTCHA_SECRET set, the routes below need a human-looking reCAPTCHA token. The gateway answers
# 428 and the web app gets an invisible token and repeats the request once. Empty secret: off.
RECAPTCHA_SECRET=
RECAPTCHA_SITE_KEY=
# Lowest score accepted, 0 to 1 (default 0.5).
RECAPTCHA_MIN_SCORE=0.5
# "METHOD /path" list, comma separated (default "POST /api/user/login").
RECAPTCHA_ROUTES=POST /api/user/login

# --- `network dev` (local development supervisor) ----------------------------------------------------

# Which children the API starts: any of importer,vault,billing, or empty for none.
# Unset: the API's own API_CHILDREN.
# DEV_API_CHILDREN=importer,vault,billing
