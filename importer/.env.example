# Copy to .env and fill in real values. Never commit .env.
# Variables already set in the environment (docker compose, Render) win over this file.

# gRPC server
GRPC_HOST=0.0.0.0
GRPC_PORT=50051

# Postgres connection string, the same one the API uses
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sample_erp?sslmode=disable

# Rows per spreadsheet; keep it equal to the API's MAX_IMPORT_ROWS
MAX_IMPORT_ROWS=5000

# Imports processed at the same time by this instance
IMPORT_WORKERS=2
# How long an import may run before it counts as stuck and goes back to the queue (Go duration)
IMPORT_LEASE=5m
# Claims before an import that keeps crashing the worker is marked as failed
IMPORT_MAX_ATTEMPTS=3
# Fallback queue check and stuck-import sweep, in case a notification was missed
IMPORT_POLL_INTERVAL=30s
