# Copy to launcher.env to change the defaults below. ERP_* environment variables win over this file.

# The gateway (services/network.exe): the only public port, serving the web app, /api and /billing.
ERP_WEB_PORT=8080
# 0.0.0.0 to serve other machines; then also set a certificate below, or a TLS proxy and ERP_TRUST_PROXY
ERP_BIND=127.0.0.1
# HTTPS: both PEM files, or neither
ERP_TLS_CERT=
ERP_TLS_KEY=
# requests per second per client IP, and the burst allowed above it; ERP_RATE=0 turns limiting off
ERP_RATE=20
ERP_BURST=40
# true only behind a proxy you run: X-Forwarded-For then decides the client IP
ERP_TRUST_PROXY=false
# request body caps in MB; the spreadsheet imports get the second
ERP_MAX_BODY_MB=1
ERP_MAX_IMPORT_MB=128

# Internal ports, all on 127.0.0.1 and never reached from outside; the gateway forwards to them.
ERP_API_PORT=3333
# not 5432, so it never collides with a Postgres already installed on this machine
ERP_DB_PORT=5433
ERP_IMPORTER_PORT=50051
ERP_BILLING_PORT=8081
# the network registry the services announce themselves on (the gateway finds them there)
ERP_NETWORK_PORT=7070
# the vault (encrypted CPF / birth dates); its keys are in data/vault-keys, DPAPI-protected for this
# Windows user: back up data/ and restore it as the same user on the same machine
ERP_VAULT_PORT=8200

# importer goroutines working on spreadsheet imports at once
ERP_IMPORT_WORKERS=2

# The first superuser, which the API creates while the database has none. Its password is a known one,
# so the web app asks for a new one at first sign-in. More users: Usuários > Novo in the web app.
ERP_ADMIN_NAME=John Doe
ERP_ADMIN_EMAIL=admin@sample-erp.local
ERP_ADMIN_PASSWORD=change-me

# false: don't open the browser once the API is up
ERP_OPEN_BROWSER=true
