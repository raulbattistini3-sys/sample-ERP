# Copy to billing.env to run the Stripe service too; without that file it stays off.
# The launcher sets JDBC_DATABASE_URL, ERP_API_URL, BILLING_TLS_* (mutual TLS with the API, data/certs),
# NETWORK_TOKEN and BILLING_PORT itself, so the
# local database is used even if this file was copied from billing/.env.

# Sandbox key (sk_test_...). Never a live key here
SANDBOX_STRIPE_API_KEY=
# Printed by `stripe listen --forward-to localhost:8080/billing/webhooks/stripe` (through the gateway)
STRIPE_WEBHOOK_SECRET=
