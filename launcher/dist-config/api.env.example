# Copy to api.env for the API's optional features; every line can stay empty. An existing api/.env
# works here as is: the launcher always replaces DATABASE_URL, APP_HOST, PORT, CORS_ORIGINS, WEB_URL,
# API_PUBLIC_URL, IMPORTER_GRPC_URL, IMPORTER_TLS_*, VAULT_*, API_TLS_*, BILLING_URL and NETWORK_TOKEN with its
# own values. The API serves HTTPS (TLS 1.3) behind the gateway, and the importer, the vault and billing
# are reached over mutual TLS with certificates the launcher makes on first launch
# (data/certs/). JWT_SECRET (an HS256 key) is generated then too, into data/secrets.env; set it here only
# to override it, with 32+ random characters.

# "Esqueceu a senha?" e-mails, sent through Resend (https://resend.com/api-keys)
RESEND_API_KEY=
EMAIL_FROM=

# Integrations. 32 random bytes, base64; changing it makes stored connections unreadable
INTEGRATIONS_ENCRYPTION_KEY=
# OAuth callbacks: http://localhost:3333/integracoes/<jira|hubspot>/callback
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_SERVICE_KEY=

# pg-boss schema, in the same database
PGBOSS_SCHEMA=pgboss
