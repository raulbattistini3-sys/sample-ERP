# Copy to .env and point it at the running API. Required: `vite` and `vite build` stop with a [config]
# message and exit status 1 without it.
VITE_API_URL=https://localhost:3333

# The dev server serves HTTPS (TLS 1.3 only) with secrets/tls/web.crt when it exists (`bun run secrets`);
# these point it at another certificate. Import secrets/tls/ca.crt once so the browser trusts both the web
# app and the API (README, "Trusting the local CA").
WEB_TLS_CERT=
WEB_TLS_KEY=

# development, dev.* or production. Dev-only tools ("Gerar dados fictícios", the search timing lines) need a
# value starting with "dev". Unset: development under `vite`, production in `vite build`.
VITE_ENVIRONMENT=

# Search timing lines under the product filters ("1.234 de 50.000 produtos · 2,1 ms em segundo plano") and
# the Clientes/Empresas search. Unset: shown in a dev.* environment only. true/false forces it.
VITE_SEARCH_TIMINGS=

# How the product list reaches the API: rest (default) or socket (a WebSocket with protobuf frames, on the
# API's port at /ws). ?transport=rest|socket on /products overrides it. The socket falls back to REST
# whenever it can't connect, e.g. behind the launcher's gateway, which doesn't forward sockets yet.
VITE_PRODUCTS_TRANSPORT=

# The network service (network/, Go): with these the dev server announces itself as "web", so the gateway
# serves the app (HMR included) next to /api and /billing. Not exposed to the browser (no VITE_ prefix).
NETWORK_URL=
NETWORK_TOKEN=
