# Copy to billing/.env, which git ignores.

# Sandbox key (sk_test_...). Never a live key here
SANDBOX_STRIPE_API_KEY=
# Printed by `stripe listen`; a deployed endpoint has its own secret in Workbench > Webhooks
STRIPE_WEBHOOK_SECRET=

# Optional: these default to localhost:5432, database billing, user postgres
BILLING_DB_URL=jdbc:postgresql://localhost:5432/billing
BILLING_DB_USERNAME=postgres
BILLING_DB_PASSWORD=
BILLING_PORT=8081
