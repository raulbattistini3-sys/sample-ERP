# Copy to billing/.env, which git ignores.

# Sandbox key (sk_test_...). Never a live key here
SANDBOX_STRIPE_API_KEY=
# Printed by `stripe listen`; a deployed endpoint has its own secret in Workbench > Webhooks
STRIPE_WEBHOOK_SECRET=

# The ERP's Supabase database through the session pooler (port 5432, not the transaction pooler's 6543)
JDBC_DATABASE_URL=jdbc:postgresql://<pooler-host>:5432/postgres?user=<user>&password=<password>

# The Node API, and the token it expects: the same value as BILLING_INTERNAL_TOKEN in api/.env.
# [::1] because APP_HOST=localhost binds IPv6 only here, and Java resolves localhost to 127.0.0.1
ERP_API_URL=http://[::1]:4444
BILLING_INTERNAL_TOKEN=

# Optional
BILLING_PORT=8081
