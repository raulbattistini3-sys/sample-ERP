# Copy to billing/.env, which git ignores.

# Sandbox key (sk_test_...). Never a live key here
SANDBOX_STRIPE_API_KEY=
# Printed by `stripe listen`; a deployed endpoint has its own secret in Workbench > Webhooks
STRIPE_WEBHOOK_SECRET=

# Required. How billing connects to Postgres (config/DatabaseTls.java):
#   production   TLS, verifying the server's certificate with DATABASE_CA_CERT, or else prod-ca-2021.crt
#                found from the working directory upwards (it lives in the repo root); sslmode=disable refused
#   development  plain connection, unless DATABASE_CA_CERT is set
# Missing required variables stop billing at startup with a [config] message and exit status 1.
BILLING_ENV=development
DATABASE_CA_CERT=

# The ERP's Supabase database through the session pooler (port 5432, not the transaction pooler's 6543)
JDBC_DATABASE_URL=jdbc:postgresql://<pooler-host>:5432/postgres?user=<user>&password=<password>

# The Node API, over HTTPS. An IP, not localhost: Java resolves that to 127.0.0.1, so it must match the
# API's APP_HOST. docker-compose.yml replaces it
ERP_API_URL=https://127.0.0.1:3333

# Mutual TLS with the API, TLS 1.3 only (no shared token): billing serves HTTPS with this certificate (names
# billing, localhost, 127.0.0.1), shows it when calling the API, and trusts only certificates signed by the
# internal CA; /internal/** answers only the API's (CN=api). Written by `cd secrets && bun generate.ts`.
BILLING_TLS_CERT=../secrets/tls/billing.crt
BILLING_TLS_KEY=../secrets/tls/billing.key
BILLING_TLS_CA=../secrets/tls/ca.crt

# Optional
BILLING_PORT=8081
# The network service (network/, Go): with these billing announces itself as "billing" and finds the API by
# name, so ERP_API_URL becomes optional. NETWORK_TOKEN is the same value in every service (32+ characters;
# secrets/secrets.env).
NETWORK_URL=
NETWORK_TOKEN=
NETWORK_ADVERTISE_HOST=127.0.0.1
