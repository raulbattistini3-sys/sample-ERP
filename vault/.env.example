# Vault: the ERP's sensitive fields (CPF, birth date, ...) encrypted in their own database.
# Copy to vault/.env for `go run ./vault/cmd/vault`. Docker compose and the launcher set these themselves.

VAULT_ENV=development
# 127.0.0.1 outside docker; the image listens on 0.0.0.0 inside the compose network only (no published port)
VAULT_HOST=127.0.0.1
VAULT_PORT=8200

# The vault's OWN Postgres database, never the ERP's (DATABASE_URL in api/.env).
VAULT_DATABASE_URL=postgres://vault:vault@localhost:5433/sample_erp_vault

# Key folder: kek-<n>.key (key-encryption keys, newest wins) and index.key (blind-index HMAC key).
# secrets/generate.ts writes secrets/vault/; never commit it, never put it in the database or an image.
VAULT_KEY_DIR=../secrets/vault
# true: create kek-1 and the index key when the folder is empty (the launcher does this, under DPAPI)
VAULT_KEY_CREATE=false
# file (hex, file permissions) | dpapi (Windows: bound to the user account). Default: dpapi on Windows.
VAULT_KEY_PROTECTION=file

# SHA-256 (hex) of the tokens; the plain token stays with the caller (VAULT_TOKEN in api/.env).
# Both are in secrets/secrets.env after `bun secrets/generate.ts`.
VAULT_TOKEN_SHA256=
# optional: the token allowed to call POST /v1/keys/rotate
VAULT_ADMIN_TOKEN_SHA256=

# Mutual TLS with the API (required when VAULT_ENV=production). secrets/tls/ from secrets/generate.ts.
VAULT_TLS_CERT=
VAULT_TLS_KEY=
VAULT_TLS_CLIENT_CA=
